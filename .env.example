# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública del despliegue (VPS con nginx).
# Producción: https://servicios.algoritmojuridico.com/ialegal/
APP_URL="https://servicios.algoritmojuridico.com/ialegal/"

# NEO4J Connection configuration (Optional - user instance)
NEO4J_URI="bolt://161.97.181.77:7687"
NEO4J_HTTP_URL="http://161.97.181.77:7474"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="YOUR_NEO4J_PASSWORD"

